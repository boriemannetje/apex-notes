{
  "name": "apex-notes",
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:web:prod": "node scripts/build-web.mjs --minify",
    "build:site": "npm run build:web:prod",
    "package:mac": "scripts/package-macos-release.sh",
    "serve": "npm run build:web && python3 -m http.server 8765 -d web",
    "dev": "tauri dev",
    "build": "npm run build:web:prod && tauri build",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --experimental-strip-types --test web/*.test.js web/**/*.test.ts",
    "test:coverage": "node --experimental-strip-types --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=70 --test-coverage-include=web/notes/*.ts --test-coverage-include=web/persistence/*.ts --test-coverage-include=web/state/*.ts --test-coverage-include=web/ui/*.ts --test-coverage-include=web/search*.ts web/*.test.js web/**/*.test.ts",
    "test:e2e": "APEX_NOTES_BUILD_CHANNEL=main-production npm run build:web:prod && node --test tests/e2e/*.test.js",
    "test:pr": "npm test && npm run test:coverage && npm run test:e2e && cargo test --manifest-path src-tauri/Cargo.toml && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "lucide": "1.16.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3"
  }
}
